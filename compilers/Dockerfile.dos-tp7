# Turbo Pascal 7 / DOS real-mode path (Liero pilot).
# TP7 is Borland commercial abandonware: Dockerfile documents the setup; user supplies media (BYOD), nothing committed.
# Proxy today: Free Pascal in TP7-compat mode (fpc -Mtp) + DOSBox for behavioral parity; byte-exact needs real TP7 + identical RTL.
FROM ubuntu:22.04
RUN apt-get update && apt-get install -y --no-install-recommends \
        make dosbox python3 fp-compiler \
    && rm -rf /var/lib/apt/lists/*
# Fail the build loudly if the compiler is missing (do NOT silently fall back).
RUN fpc -iV || (echo "FATAL: fp-compiler did not install" && exit 1)
ENV FPC_TP_MODE=-Mtp
WORKDIR /src
CMD ["fpc", "-h"]
